<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="White">
    <color rgba="1 1 1 0.7"/>
  </material>

  <material name="Blue">
    <color rgba="0 0 1 0.8"/>
  </material>

  <material name="Black">
    <color rgba="0 0 0 0.8"/>
  </material>

  <!-- BASE -->

  <link name="base_link">

    <visual>
      <geometry>
        <cylinder radius="0.2" length="0.5"/>
      </geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <material name="Blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.2" length="0.5"/>
      </geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="2.0"/>

      <origin xyz="0 0 0.2" rpy="0 0 0"/>

      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>

  </link>

  <!-- HEAD -->

  <link name="head">

    <visual>
      <geometry>
        <sphere radius="0.19"/>
      </geometry>
      <material name="White"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.19"/>
      </geometry>
    </collision>

    <inertial>

      <mass value="1.0"/>

      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>

    </inertial>

  </link>

  <joint name="base_head" type="continuous">

    <parent link="base_link"/>
    <child link="head"/>

    <origin xyz="0 0 0.55" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>

  <!-- LEG MACRO -->

  <xacro:macro name="leg" params="name ypos yorg">

    <link name="${name}">

      <visual>
        <geometry>
          <box size="0.2 0.06 0.5"/>
        </geometry>

        <origin xyz="0 ${ypos} 0.2" rpy="0 0 0"/>

        <material name="White"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.2 0.06 0.5"/>
        </geometry>

        <origin xyz="0 ${ypos} 0.2" rpy="0 0 0"/>
      </collision>

      <inertial>

        <mass value="1.0"/>

        <inertia
          ixx="0.02"
          ixy="0.0"
          ixz="0.0"
          iyy="0.02"
          iyz="0.0"
          izz="0.02"/>

      </inertial>

    </link>

    <joint name="base_${name}" type="fixed">

      <parent link="base_link"/>
      <child link="${name}"/>

      <origin xyz="0 ${yorg} 0" rpy="0 0 0"/>

    </joint>

  </xacro:macro>

  <!-- BASE MACRO -->

  <xacro:macro name="base" params="pname cname ypos">

    <link name="${cname}">

      <visual>
        <geometry>
          <box size="0.4 0.08 0.09"/>
        </geometry>

        <origin xyz="0 ${ypos} 0" rpy="0 0 0"/>

        <material name="White"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.4 0.08 0.09"/>
        </geometry>

        <origin xyz="0 ${ypos} 0" rpy="0 0 0"/>
      </collision>

      <inertial>

        <mass value="0.8"/>

        <inertia
          ixx="0.01"
          ixy="0.0"
          ixz="0.0"
          iyy="0.01"
          iyz="0.0"
          izz="0.01"/>

      </inertial>

    </link>

    <joint name="base_${cname}" type="fixed">

      <parent link="${pname}"/>
      <child link="${cname}"/>

      <origin xyz="0 0 0" rpy="0 0 0"/>

    </joint>

  </xacro:macro>

  <!-- WHEEL MACRO -->

  <xacro:macro name="wheel" params="pname cname xpos ypos">

    <link name="${cname}">

      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.08"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5707 0 0"/>

        <material name="Black"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.08"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      </collision>

      <inertial>

        <mass value="0.3"/>

        <inertia
          ixx="0.001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.001"
          iyz="0.0"
          izz="0.001"/>

      </inertial>

    </link>

    <joint name="base_${cname}" type="continuous">

      <parent link="${pname}"/>
      <child link="${cname}"/>

      <origin xyz="${xpos} ${ypos} -0.03" rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>

  <!-- ROBOT ASSEMBLY -->

  <xacro:leg name="right_leg" ypos="0.2" yorg="0.02"/>
  <xacro:leg name="left_leg" ypos="-0.2" yorg="-0.02"/>

  <xacro:base pname="right_leg" cname="right_base" ypos="0.2"/>
  <xacro:base pname="left_leg" cname="left_base" ypos="-0.2"/>

  <xacro:wheel pname="right_base" cname="right_wheel1" xpos="0.2" ypos="0.2"/>
  <xacro:wheel pname="right_base" cname="right_wheel2" xpos="-0.2" ypos="0.2"/>

  <xacro:wheel pname="left_base" cname="left_wheel1" xpos="0.2" ypos="-0.2"/>
  <xacro:wheel pname="left_base" cname="left_wheel2" xpos="-0.2" ypos="-0.2"/>

</robot>